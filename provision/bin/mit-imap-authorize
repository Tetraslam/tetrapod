#!/usr/bin/env python3
"""Hold an IMAP login connection open long enough to complete Microsoft 365 device auth.

email-oauth2-proxy aborts its device-code poll if the IMAP client disconnects.
Mail clients like Omamail time out after ~30 seconds, so this script holds a
10-minute IMAP login open while printing the live device-code prompt from the
email-oauth2-proxy journal.
"""

from __future__ import annotations

import imaplib
import subprocess
import sys
import threading
import time

HOST = "tetrapod.tailc27667.ts.net"
PORT = 1993
ACCOUNT = "shresht@mit.edu"
PASSWORD_REF = "op://Agents/MIT Mail Proxy/password"


def tail_device_code(stop: threading.Event, since: str) -> None:
    seen: set[str] = set()
    while not stop.is_set():
        out = subprocess.run(
            [
                "journalctl",
                "-u",
                "email-oauth2-proxy.service",
                "--since",
                since,
                "--no-pager",
                "-o",
                "cat",
            ],
            capture_output=True,
            text=True,
        ).stdout
        for line in out.splitlines():
            if "Visit https://login.microsoft.com/device" in line and line not in seen:
                seen.add(line)
                print(line, flush=True)
        stop.wait(1.0)


def main() -> int:
    password = subprocess.run(
        ["opa", "read", PASSWORD_REF], capture_output=True, text=True, check=True
    ).stdout.strip()
    since = time.strftime("%Y-%m-%d %H:%M:%S")
    stop = threading.Event()
    watcher = threading.Thread(target=tail_device_code, args=(stop, since), daemon=True)
    watcher.start()
    try:
        imap = imaplib.IMAP4_SSL(HOST, PORT, timeout=600)
        typ, data = imap.login(ACCOUNT, password)
        print(f"authorized IMAP for {ACCOUNT}: {typ}", flush=True)
        imap.logout()
        return 0
    except Exception as exc:
        print(f"mit-imap-authorize failed: {exc}", file=sys.stderr)
        return 1
    finally:
        stop.set()


if __name__ == "__main__":
    raise SystemExit(main())
