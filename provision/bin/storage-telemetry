#!/usr/bin/env python3
"""Small, read-only storage telemetry API for the wiki dashboard."""

from __future__ import annotations

import argparse
import json
import shutil
import threading
import time
import urllib.request
import xml.etree.ElementTree as ET
from concurrent.futures import ThreadPoolExecutor
from datetime import datetime, timezone
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from typing import Any, Callable

API_PATHS = frozenset(("/v1/storage", "/storage-api/v1/storage"))
CACHE_SECONDS = 30
MAX_RESPONSE_BYTES = 2 * 1024 * 1024
UPSTREAM_TIMEOUT = 2.0
MEDIA_PATH = "/srv/media"
SONARR_CONFIG = "/opt/tetrapod/sonarr/config.xml"
RADARR_CONFIG = "/opt/tetrapod/radarr/config.xml"
SONARR_URL = "http://127.0.0.1:8989/api/v3/series"
RADARR_URL = "http://127.0.0.1:7878/api/v3/movie"
QBIT_URL = "http://127.0.0.1:8081/api/v2/torrents/info?filter=all"


def percent(used: int, total: int) -> float:
    if total <= 0:
        return 0.0
    return round(max(0.0, used * 100.0 / total), 1)


def forecast(used: int, total: int, pending: int | None) -> tuple[int | None, float | None]:
    if pending is None:
        return None, None
    forecast_used = max(0, used) + max(0, pending)
    return forecast_used, percent(forecast_used, total)


def largest_titles(*groups: tuple[str, list[dict[str, Any]]]) -> list[dict[str, Any]]:
    titles: list[dict[str, Any]] = []
    for kind, records in groups:
        for record in records:
            title = record.get("title")
            statistics = record.get("statistics")
            size = statistics.get("sizeOnDisk", 0) if isinstance(statistics, dict) else 0
            if kind == "movie" and not size:
                movie_file = record.get("movieFile")
                size = movie_file.get("size", 0) if isinstance(movie_file, dict) else 0
            if isinstance(title, str) and title.strip() and isinstance(size, (int, float)):
                titles.append({"title": title.strip()[:200], "type": kind, "size_bytes": max(0, int(size))})
    return sorted(titles, key=lambda item: (-item["size_bytes"], item["title"].casefold()))[:5]


def read_api_key(path: str) -> str:
    key = ET.parse(path).findtext("ApiKey")
    if not key or not key.strip():
        raise ValueError("missing key")
    return key.strip()


def fetch_json(url: str, api_key: str | None = None) -> Any:
    headers = {"Accept": "application/json"}
    if api_key:
        headers["X-Api-Key"] = api_key
    request = urllib.request.Request(url, headers=headers)
    with urllib.request.urlopen(request, timeout=UPSTREAM_TIMEOUT) as response:
        content_length = response.headers.get("Content-Length")
        if content_length and int(content_length) > MAX_RESPONSE_BYTES:
            raise ValueError("response too large")
        body = response.read(MAX_RESPONSE_BYTES + 1)
        if len(body) > MAX_RESPONSE_BYTES:
            raise ValueError("response too large")
    return json.loads(body)


def fetch_arr(url: str, config_path: str) -> list[dict[str, Any]]:
    data = fetch_json(url, read_api_key(config_path))
    if not isinstance(data, list):
        raise ValueError("invalid response")
    return [record for record in data if isinstance(record, dict)]


def fetch_downloads() -> tuple[int, int | None]:
    data = fetch_json(QBIT_URL)
    if not isinstance(data, list):
        raise ValueError("invalid response")
    pending = 0
    pending_known = True
    count = 0
    for torrent in data:
        if not isinstance(torrent, dict):
            continue
        progress = torrent.get("progress")
        if isinstance(progress, (int, float)) and progress >= 1:
            continue
        amount_left = torrent.get("amount_left")
        if not isinstance(amount_left, (int, float)) or amount_left <= 0:
            total = torrent.get("total_size", 0)
            completed = torrent.get("completed", 0)
            if isinstance(total, (int, float)) and total > 0 and isinstance(completed, (int, float)):
                amount_left = max(0, total - completed)
            else:
                amount_left = 0
                pending_known = False
        count += 1
        pending += max(0, int(amount_left))
    return count, pending if pending_known else None


def empty_payload(now: datetime) -> dict[str, Any]:
    return {
        "version": 1,
        "generated_at": now.isoformat().replace("+00:00", "Z"),
        "storage": {"path": MEDIA_PATH, "total_bytes": None, "used_bytes": None, "free_bytes": None, "used_percent": None},
        "downloads": {"incomplete_count": None, "pending_bytes": None},
        "forecast": {"used_bytes": None, "used_percent": None},
        "largest_titles": [],
        "warnings": [],
    }


def collect(
    disk_usage: Callable[[str], Any] = shutil.disk_usage,
    downloads: Callable[[], tuple[int, int | None]] = fetch_downloads,
    sonarr: Callable[[], list[dict[str, Any]]] | None = None,
    radarr: Callable[[], list[dict[str, Any]]] | None = None,
) -> tuple[dict[str, Any], int]:
    payload = empty_payload(datetime.now(timezone.utc))
    warnings: list[str] = payload["warnings"]
    try:
        disk = disk_usage(MEDIA_PATH)
        total, used, free = int(disk.total), int(disk.used), int(disk.free)
        payload["storage"] = {
            "path": MEDIA_PATH,
            "total_bytes": total,
            "used_bytes": used,
            "free_bytes": free,
            "used_percent": percent(used, total),
        }
    except Exception:
        warnings.append("storage_unavailable")
        total = used = 0

    tasks = {
        "downloads": downloads,
        "sonarr": sonarr or (lambda: fetch_arr(SONARR_URL, SONARR_CONFIG)),
        "radarr": radarr or (lambda: fetch_arr(RADARR_URL, RADARR_CONFIG)),
    }
    results: dict[str, Any] = {}
    with ThreadPoolExecutor(max_workers=3, thread_name_prefix="telemetry") as executor:
        futures = {name: executor.submit(task) for name, task in tasks.items()}
        for name, future in futures.items():
            try:
                results[name] = future.result()
            except Exception:
                warnings.append(f"{name}_unavailable")

    if "downloads" in results:
        count, pending = results["downloads"]
        payload["downloads"] = {"incomplete_count": count, "pending_bytes": pending}
        if "storage_unavailable" not in warnings:
            forecast_used, forecast_percent = forecast(used, total, pending)
            payload["forecast"] = {"used_bytes": forecast_used, "used_percent": forecast_percent}
    payload["largest_titles"] = largest_titles(
        ("series", results.get("sonarr", [])), ("movie", results.get("radarr", []))
    )
    warnings.sort()
    return payload, 503 if "storage_unavailable" in warnings else 200


class TelemetryCache:
    def __init__(self, ttl: int = CACHE_SECONDS, collector: Callable[[], tuple[dict[str, Any], int]] = collect):
        self.ttl = ttl
        self.collector = collector
        self._lock = threading.Lock()
        self._expires = 0.0
        self._value: tuple[dict[str, Any], int] | None = None

    def get(self) -> tuple[dict[str, Any], int]:
        now = time.monotonic()
        with self._lock:
            if self._value is None or now >= self._expires:
                self._value = self.collector()
                self._expires = time.monotonic() + self.ttl
            return self._value


class Handler(BaseHTTPRequestHandler):
    server_version = "storage-telemetry"
    sys_version = ""

    def _send(self, head_only: bool = False) -> None:
        if self.path not in API_PATHS:
            self.send_error(404, "not found")
            return
        payload, status = self.server.cache.get()  # type: ignore[attr-defined]
        body = json.dumps(payload, sort_keys=True, separators=(",", ":")).encode("utf-8")
        self.send_response(status)
        self.send_header("Content-Type", "application/json")
        self.send_header("Cache-Control", f"private, max-age={CACHE_SECONDS}")
        self.send_header("Content-Length", str(len(body)))
        self.send_header("X-Content-Type-Options", "nosniff")
        self.end_headers()
        if not head_only:
            self.wfile.write(body)

    def do_GET(self) -> None:
        self._send()

    def do_HEAD(self) -> None:
        self._send(head_only=True)

    def _method_not_allowed(self) -> None:
        self.send_response(405)
        self.send_header("Allow", "GET, HEAD")
        self.send_header("Content-Length", "0")
        self.end_headers()

    do_POST = do_PUT = do_PATCH = do_DELETE = do_OPTIONS = _method_not_allowed

    def log_message(self, format: str, *args: Any) -> None:
        # Paths are fixed and upstream details never reach the journal.
        return


class Server(ThreadingHTTPServer):
    daemon_threads = True
    allow_reuse_address = True
    request_queue_size = 16

    def __init__(self, address: tuple[str, int], cache: TelemetryCache):
        super().__init__(address, Handler)
        self.cache = cache


def main() -> None:
    parser = argparse.ArgumentParser(description="serve storage telemetry")
    parser.add_argument("--host", default="127.0.0.1")
    parser.add_argument("--port", type=int, default=3005)
    args = parser.parse_args()
    Server((args.host, args.port), TelemetryCache()).serve_forever()


if __name__ == "__main__":
    main()
