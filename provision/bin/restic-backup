#!/bin/bash
# restic-backup (tetrapod) — encrypted offsite backup to Tigris.
# Creds: op://Agents/RESTIC_BACKUP_TETRAPOD (read promptless via opa).
# Runs nightly via the restic-backup system timer (as root, token file from
# ubuntu's home via OP_AGENTS_TOKEN_FILE).
# Usage: restic-backup [backup|snapshots|check|restore <snap> <target>|...]
#   No args = backup. Anything else passes straight to restic with env set.
set -euo pipefail

# runs as root (sudo / systemd) but the opa token lives in tetraslam's home
export OP_AGENTS_TOKEN_FILE="${OP_AGENTS_TOKEN_FILE:-/home/tetraslam/.config/op/agents-token}"

KUMA_PUSH_URL="$(opa read 'op://Agents/RESTIC_BACKUP_TETRAPOD/kuma push url' 2>/dev/null || true)"
ping_kuma() {
  case "$KUMA_PUSH_URL" in
    http*)
      curl -fsS --retry 2 --retry-all-errors -m 10 --get \
        --data-urlencode "status=$1" --data-urlencode "msg=$2" \
        "${KUMA_PUSH_URL%%\?*}" >/dev/null ||
        printf 'restic-backup: failed to report %s status to Kuma\n' "$1" >&2
      ;;
  esac
}

on_error() {
  local exit_code=$?
  trap - ERR
  ping_kuma down "backup failed (exit $exit_code)"
  exit "$exit_code"
}
trap on_error ERR

AWS_ACCESS_KEY_ID="$(opa read 'op://Agents/RESTIC_BACKUP_TETRAPOD/access key id')"
AWS_SECRET_ACCESS_KEY="$(opa read 'op://Agents/RESTIC_BACKUP_TETRAPOD/secret access key')"
RESTIC_REPOSITORY="$(opa read 'op://Agents/RESTIC_BACKUP_TETRAPOD/repository')"
RESTIC_PASSWORD="$(opa read 'op://Agents/RESTIC_BACKUP_TETRAPOD/repo password')"
export AWS_ACCESS_KEY_ID AWS_SECRET_ACCESS_KEY RESTIC_REPOSITORY RESTIC_PASSWORD

if [ "${1:-backup}" != "backup" ]; then
  trap - ERR
  exec restic "$@"
fi

restic backup \
  --exclude '**/node_modules' \
  --exclude '**/.venv' \
  --exclude '**/__pycache__' \
  --exclude '**/target/debug' \
  --exclude '**/target/release' \
  --exclude '**/.cache' \
  --exclude '**/logs.db*' \
  /home/tetraslam \
  /opt/tetrapod

# keep history bounded: 7 daily, 4 weekly, 12 monthly
restic forget --prune --keep-daily 7 --keep-weekly 4 --keep-monthly 12 --quiet

# Monitoring remains best-effort so a lighthouse outage cannot fail a backup.
ping_kuma up OK
