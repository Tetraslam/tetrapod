#!/bin/bash
set -euo pipefail

state_dir=/opt/tetrapod/media-reconcile
state="$state_dir/state.json"
retry_seconds=3600
now="$(date +%s)"

mkdir -p "$state_dir"
[ -f "$state" ] || printf '{"sonarr":{},"radarr":{}}\n' >"$state"

last_search() {
  jq -r --arg app "$1" --arg id "$2" '.[$app][$id] // 0' "$state"
}

mark_searched() {
  local tmp
  tmp="$(mktemp "$state_dir/state.XXXXXX")"
  jq --arg app "$1" --arg id "$2" --argjson now "$now" '.[$app][$id] = $now' "$state" >"$tmp"
  mv "$tmp" "$state"
}

sonarr_key="$(xmlstarlet sel -t -v /Config/ApiKey /opt/tetrapod/sonarr/config.xml)"
sonarr=http://127.0.0.1:8989/api/v3
sonarr_api() {
  curl -fsS -H "X-Api-Key: $sonarr_key" "$@"
}

sonarr_search_active="$(sonarr_api "$sonarr/command" | jq 'any(.[]; (.name == "SeriesSearch" or .name == "MissingEpisodeSearch") and (.status == "queued" or .status == "started"))')"
sonarr_search_started=false

while IFS=$'\t' read -r id title series_type quality_profile monitored is_anime aired files; do
  if [ "$is_anime" = true ] && [ "$series_type" != anime ]; then
    sonarr_api "$sonarr/series/$id" |
      jq '.seriesType = "anime"' |
      sonarr_api -X PUT -H 'Content-Type: application/json' --data-binary @- "$sonarr/series/$id" >/dev/null
    echo "media-reconcile: classified $title as anime"
  fi

  if [ "$quality_profile" = 1 ]; then
    sonarr_api "$sonarr/series/$id" |
      jq '.qualityProfileId = 4' |
      sonarr_api -X PUT -H 'Content-Type: application/json' --data-binary @- "$sonarr/series/$id" >/dev/null
    echo "media-reconcile: set $title to HD-1080p"
  fi

  previous="$(last_search sonarr "$id")"
  if [ "$monitored" = true ] && [ "$aired" -gt "$files" ] &&
     [ "$sonarr_search_active" = false ] && [ "$sonarr_search_started" = false ] &&
     [ $((now - previous)) -ge "$retry_seconds" ]; then
    sonarr_api -X POST -H 'Content-Type: application/json' \
      --data-binary "$(jq -cn --argjson id "$id" '{name:"SeriesSearch",seriesId:$id}')" \
      "$sonarr/command" >/dev/null
    mark_searched sonarr "$id"
    sonarr_search_started=true
    echo "media-reconcile: searching missing episodes for $title"
  fi
done < <(sonarr_api "$sonarr/series" | jq -r '.[] | [
  .id,
  .title,
  .seriesType,
  .qualityProfileId,
  .monitored,
  ((.genres | index("Anime") != null) or
    (.originalLanguage.name == "Japanese" and (.genres | index("Animation") != null))),
  .statistics.episodeCount,
  .statistics.episodeFileCount
] | @tsv')

radarr_key="$(xmlstarlet sel -t -v /Config/ApiKey /opt/tetrapod/radarr/config.xml)"
radarr=http://127.0.0.1:7878/api/v3
radarr_api() {
  curl -fsS -H "X-Api-Key: $radarr_key" "$@"
}

radarr_search_active="$(radarr_api "$radarr/command" | jq 'any(.[]; .name == "MoviesSearch" and (.status == "queued" or .status == "started"))')"
radarr_search_started=false

while IFS=$'\t' read -r id title quality_profile monitored has_file available; do
  if [ "$quality_profile" = 1 ]; then
    radarr_api "$radarr/movie/$id" |
      jq '.qualityProfileId = 4' |
      radarr_api -X PUT -H 'Content-Type: application/json' --data-binary @- "$radarr/movie/$id" >/dev/null
    echo "media-reconcile: set $title to HD-1080p"
  fi

  previous="$(last_search radarr "$id")"
  if [ "$monitored" = true ] && [ "$has_file" = false ] && [ "$available" = true ] &&
     [ "$radarr_search_active" = false ] && [ "$radarr_search_started" = false ] &&
     [ $((now - previous)) -ge "$retry_seconds" ]; then
    radarr_api -X POST -H 'Content-Type: application/json' \
      --data-binary "$(jq -cn --argjson id "$id" '{name:"MoviesSearch",movieIds:[$id]}')" \
      "$radarr/command" >/dev/null
    mark_searched radarr "$id"
    radarr_search_started=true
    echo "media-reconcile: searching releases for $title"
  fi
done < <(radarr_api "$radarr/movie" | jq -r '.[] | [
  .id,
  .title,
  .qualityProfileId,
  .monitored,
  .hasFile,
  .isAvailable
] | @tsv')

file_count="$(jq -n \
  --argjson sonarr "$(sonarr_api "$sonarr/series")" \
  --argjson radarr "$(radarr_api "$radarr/movie")" \
  '[($sonarr | map(.statistics.episodeFileCount) | add // 0),
    ($radarr | map(.statistics.movieFileCount) | add // 0)] | add')"
previous_file_count="$(jq -r '.jellyfin.fileCount // -1' "$state")"

if [ "$file_count" != "$previous_file_count" ]; then
  jellyfin_token="$(sqlite3 /opt/tetrapod/jellyfin/config/data/jellyfin.db \
    'SELECT AccessToken FROM ApiKeys ORDER BY Id LIMIT 1;' 2>/dev/null || true)"
  if [ -n "$jellyfin_token" ]; then
    curl -fsS -X POST http://127.0.0.1:8096/Library/Refresh \
      -H "Authorization: MediaBrowser Token=\"$jellyfin_token\""
    tmp="$(mktemp "$state_dir/state.XXXXXX")"
    jq --argjson count "$file_count" '.jellyfin.fileCount = $count' "$state" >"$tmp"
    mv "$tmp" "$state"
    echo "media-reconcile: refreshed Jellyfin library"
  fi
fi
