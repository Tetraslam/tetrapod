#!/bin/bash
set -euo pipefail

state_dir=/var/lib/media-reconcile
state="$state_dir/state.json"
retry_seconds=3600
fallback_seconds=300
now="$(date +%s)"

mkdir -p "$state_dir"
[ -f "$state" ] || printf '{"sonarr":{},"radarr":{}}\n' >"$state"

last_search() {
  jq -r --arg app "$1" --arg id "$2" '.[$app][$id] // 0' "$state"
}

last_fallback() {
  jq -r --arg id "$1" '.sonarrFallback[$id] // 0' "$state"
}

mark_searched() {
  local tmp
  tmp="$(mktemp "$state_dir/state.XXXXXX")"
  jq --arg app "$1" --arg id "$2" --argjson now "$now" '.[$app][$id] = $now' "$state" >"$tmp"
  mv "$tmp" "$state"
}

mark_fallback() {
  local tmp
  tmp="$(mktemp "$state_dir/state.XXXXXX")"
  jq --arg id "$1" --argjson now "$now" '.sonarrFallback[$id] = $now' "$state" >"$tmp"
  mv "$tmp" "$state"
}

sonarr_key="$(xmlstarlet sel -t -v /Config/ApiKey /opt/tetrapod/sonarr/config.xml)"
sonarr=http://127.0.0.1:8989/api/v3
sonarr_api() {
  curl -fsS -H "X-Api-Key: $sonarr_key" "$@"
}

radarr_key="$(xmlstarlet sel -t -v /Config/ApiKey /opt/tetrapod/radarr/config.xml)"
radarr=http://127.0.0.1:7878/api/v3
radarr_api() {
  curl -fsS -H "X-Api-Key: $radarr_key" "$@"
}

qbittorrent=http://127.0.0.1:8081/api/v2

fail_stalled_downloads() {
  local torrents sonarr_queue radarr_queue failed hash name category state queue api key id
  torrents="$(mktemp "$state_dir/torrents.XXXXXX")"
  sonarr_queue="$(mktemp "$state_dir/sonarr-queue.XXXXXX")"
  radarr_queue="$(mktemp "$state_dir/radarr-queue.XXXXXX")"

  curl -fsS "$qbittorrent/torrents/info" >"$torrents"
  sonarr_api "$sonarr/queue?page=1&pageSize=1000&includeUnknownSeriesItems=true" >"$sonarr_queue"
  radarr_api "$radarr/queue?page=1&pageSize=1000&includeUnknownMovieItems=true" >"$radarr_queue"

  failed=0
  while IFS=$'\t' read -r hash name category state; do
    if [ "$category" = tv-sonarr ]; then
      queue="$sonarr_queue"
      api="$sonarr"
      key="$sonarr_key"
    else
      queue="$radarr_queue"
      api="$radarr"
      key="$radarr_key"
    fi

    id="$(jq -r --arg hash "$hash" '
      [.records[] | select(((.downloadId // "") | ascii_downcase) == $hash) | .id][0] // empty
    ' "$queue")"
    if [ -n "$id" ]; then
      curl -fsS -X DELETE -H "X-Api-Key: $key" \
        "$api/queue/$id?removeFromClient=true&blocklist=true&skipRedownload=false&changeCategory=false&message=No%20peers%20within%20the%20download%20deadline" \
        >/dev/null
    else
      curl -fsS -X POST --data-urlencode "hashes=$hash" --data-urlencode 'deleteFiles=true' \
        "$qbittorrent/torrents/delete" >/dev/null
    fi
    failed=$((failed + 1))
    echo "media-reconcile: failed stalled $state download: $name"
  done < <(jq -r --argjson now "$now" '
    [.[] | select(
      (.category == "tv-sonarr" or .category == "radarr") and
      .progress < 1 and .dlspeed == 0 and (
        (.state == "metaDL" and ($now - .added_on) >= 1800) or
        ((.state == "stalledDL" or .state == "error") and
         (.num_seeds // 0) == 0 and
         ($now - (.last_activity // .added_on)) >= 21600)
      )
    )] | sort_by(.added_on) | .[:4][] | [.hash, .name, .category, .state] | @tsv
  ' "$torrents")

  rm -f "$torrents" "$sonarr_queue" "$radarr_queue"
  [ "$failed" -eq 0 ] || echo "media-reconcile: failed $failed stalled downloads for replacement"
}

fail_stalled_downloads

ensure_quality_profile() {
  local base="$1"
  local key="$2"
  local name='HD/UHD - 1080p/2160p'
  local profiles id template

  profiles="$(curl -fsS -H "X-Api-Key: $key" "$base/qualityprofile")"
  if id="$(jq -er --arg name "$name" '.[] | select(.name == $name) | .id' <<<"$profiles" 2>/dev/null)"; then
    printf '%s\n' "$id"
    return
  fi

  template="$(curl -fsS -H "X-Api-Key: $key" "$base/qualityprofile/4")"
  id="$(jq --arg name "$name" '
    del(.id) |
    .name = $name |
    .upgradeAllowed = true |
    .cutoff = 19 |
    (.items[] | select(.quality != null)) |= (
      .allowed = (.quality.resolution >= 1080 and
        ((.quality.name | test("Remux|Raw-HD|BR-DISK"; "i")) | not))
    ) |
    (.items[] | select(.items != null and (.items | length > 0))) |= (
      .items |= map(.allowed = (.quality.resolution >= 1080)) |
      .allowed = any(.items[]; .allowed)
    )
  ' <<<"$template" |
    curl -fsS -X POST -H "X-Api-Key: $key" -H 'Content-Type: application/json' \
      --data-binary @- "$base/qualityprofile" | jq -r '.id')"
  if [[ ! "$id" =~ ^[0-9]+$ ]]; then
    echo "media-reconcile: failed to create $name quality profile" >&2
    return 1
  fi
  echo "media-reconcile: created $name quality profile" >&2
  printf '%s\n' "$id"
}

sonarr_quality_profile="$(ensure_quality_profile "$sonarr" "$sonarr_key")"

sonarr_search_active="$(sonarr_api "$sonarr/command" | jq 'any(.[]; (.name == "SeriesSearch" or .name == "MissingEpisodeSearch") and (.status == "queued" or .status == "started"))')"
sonarr_search_started=false

while IFS=$'\t' read -r id title series_type quality_profile monitored is_anime aired files; do
  if [ "$is_anime" = true ] && [ "$series_type" != anime ]; then
    sonarr_api "$sonarr/series/$id" |
      jq '.seriesType = "anime"' |
      sonarr_api -X PUT -H 'Content-Type: application/json' --data-binary @- "$sonarr/series/$id" >/dev/null
    echo "media-reconcile: classified $title as anime"
  fi

  if [ "$quality_profile" = 1 ]; then
    sonarr_api "$sonarr/series/$id" |
      jq --argjson profile "$sonarr_quality_profile" '.qualityProfileId = $profile' |
      sonarr_api -X PUT -H 'Content-Type: application/json' --data-binary @- "$sonarr/series/$id" >/dev/null
    echo "media-reconcile: set $title to 1080p/2160p"
  fi

  previous="$(last_search sonarr "$id")"
  fallback_previous="$(last_fallback "$id")"
  if [ "$monitored" = true ] && [ "$files" -eq 0 ] && [ "$previous" -gt 0 ] &&
     [ "$fallback_previous" -lt "$previous" ] &&
     [ $((now - previous)) -ge "$fallback_seconds" ] &&
     [ $((now - previous)) -lt "$retry_seconds" ]; then
    /usr/local/bin/media-release-fallback "$id" || true
    mark_fallback "$id"
  fi

  if [ "$monitored" = true ] && [ "$aired" -gt "$files" ] &&
     [ "$sonarr_search_active" = false ] && [ "$sonarr_search_started" = false ] &&
     [ $((now - previous)) -ge "$retry_seconds" ]; then
    sonarr_api -X POST -H 'Content-Type: application/json' \
      --data-binary "$(jq -cn --argjson id "$id" '{name:"SeriesSearch",seriesId:$id}')" \
      "$sonarr/command" >/dev/null
    mark_searched sonarr "$id"
    sonarr_search_started=true
    echo "media-reconcile: searching missing episodes for $title"
  fi
done < <(sonarr_api "$sonarr/series" | jq -r '.[] | [
  .id,
  .title,
  .seriesType,
  .qualityProfileId,
  .monitored,
  ((.genres | index("Anime") != null) or
    (.originalLanguage.name == "Japanese" and (.genres | index("Animation") != null))),
  .statistics.episodeCount,
  .statistics.episodeFileCount
] | @tsv')

radarr_quality_profile="$(ensure_quality_profile "$radarr" "$radarr_key")"

radarr_search_active="$(radarr_api "$radarr/command" | jq 'any(.[]; .name == "MoviesSearch" and (.status == "queued" or .status == "started"))')"
radarr_search_started=false

while IFS=$'\t' read -r id title quality_profile monitored has_file available; do
  if [ "$quality_profile" = 1 ]; then
    radarr_api "$radarr/movie/$id" |
      jq --argjson profile "$radarr_quality_profile" '.qualityProfileId = $profile' |
      radarr_api -X PUT -H 'Content-Type: application/json' --data-binary @- "$radarr/movie/$id" >/dev/null
    echo "media-reconcile: set $title to 1080p/2160p"
  fi

  previous="$(last_search radarr "$id")"
  if [ "$monitored" = true ] && [ "$has_file" = false ] && [ "$available" = true ] &&
     [ "$radarr_search_active" = false ] && [ "$radarr_search_started" = false ] &&
     [ $((now - previous)) -ge "$retry_seconds" ]; then
    radarr_api -X POST -H 'Content-Type: application/json' \
      --data-binary "$(jq -cn --argjson id "$id" '{name:"MoviesSearch",movieIds:[$id]}')" \
      "$radarr/command" >/dev/null
    mark_searched radarr "$id"
    radarr_search_started=true
    echo "media-reconcile: searching releases for $title"
  fi
done < <(radarr_api "$radarr/movie" | jq -r '.[] | [
  .id,
  .title,
  .qualityProfileId,
  .monitored,
  .hasFile,
  .isAvailable
] | @tsv')

file_count="$(jq -n \
  --argjson sonarr "$(sonarr_api "$sonarr/series")" \
  --argjson radarr "$(radarr_api "$radarr/movie")" \
  '[($sonarr | map(.statistics.episodeFileCount) | add // 0),
    ($radarr | map(.statistics.movieFileCount) | add // 0)] | add')"
previous_file_count="$(jq -r '.jellyfin.fileCount // -1' "$state")"

if [ "$file_count" != "$previous_file_count" ]; then
  jellyfin_token="$(sqlite3 /opt/tetrapod/jellyfin/config/data/jellyfin.db \
    'SELECT AccessToken FROM ApiKeys ORDER BY Id LIMIT 1;' 2>/dev/null || true)"
  if [ -n "$jellyfin_token" ]; then
    curl -fsS -X POST http://127.0.0.1:8096/Library/Refresh \
      -H "Authorization: MediaBrowser Token=\"$jellyfin_token\""
    tmp="$(mktemp "$state_dir/state.XXXXXX")"
    jq --argjson count "$file_count" '.jellyfin.fileCount = $count' "$state" >"$tmp"
    mv "$tmp" "$state"
    echo "media-reconcile: refreshed Jellyfin library"
  fi
fi
