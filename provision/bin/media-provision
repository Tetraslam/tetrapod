#!/bin/bash
set -euo pipefail

config=/opt/tetrapod/prowlarr/config.xml
ready=false
for _ in {1..30}; do
  if [ -f "$config" ] && curl -fsS http://127.0.0.1:9696/ping >/dev/null; then
    ready=true
    break
  fi
  sleep 2
done
[ "$ready" = true ] || { echo "media-provision: Prowlarr is not ready" >&2; exit 1; }

key="$(xmlstarlet sel -t -v /Config/ApiKey "$config")"
base=http://127.0.0.1:9696/api/v1
api() {
  curl -fsS -H "X-Api-Key: $key" "$@"
}

set_minimum_seeders() {
  local name="$1"
  local minimum="$2"
  local id current configured

  id="$(api "$base/indexer" | jq -er --arg name "$name" '.[] | select(.name == $name) | .id')"
  current="$(api "$base/indexer/$id")"
  configured="$(jq -r '.fields[] | select(.name == "torrentBaseSettings.appMinimumSeeders") | .value' <<<"$current")"

  if [ "$configured" != "$minimum" ]; then
    jq --argjson minimum "$minimum" \
      '(.fields[] | select(.name == "torrentBaseSettings.appMinimumSeeders")).value = $minimum' <<<"$current" |
      api -X PUT -H 'Content-Type: application/json' --data-binary @- "$base/indexer/$id" >/dev/null
    echo "media-provision: set $name minimum seeders to $minimum"
  fi
}

inherit_minimum_seeders() {
  local name="$1"
  local id current

  id="$(api "$base/indexer" | jq -er --arg name "$name" '.[] | select(.name == $name) | .id')"
  current="$(api "$base/indexer/$id")"

  if [ "$(jq -r '.fields[] | select(.name == "torrentBaseSettings.appMinimumSeeders") | .value' <<<"$current")" != null ]; then
    jq '(.fields[] | select(.name == "torrentBaseSettings.appMinimumSeeders")).value = null' <<<"$current" |
      api -X PUT -H 'Content-Type: application/json' --data-binary @- "$base/indexer/$id" >/dev/null
    echo "media-provision: set $name to the fallback seeder policy"
  fi
}

profile="$(api "$base/appprofile/1")"
if [ "$(jq -r '.minimumSeeders' <<<"$profile")" != 3 ]; then
  jq '.minimumSeeders = 3' <<<"$profile" |
    api -X PUT -H 'Content-Type: application/json' --data-binary @- "$base/appprofile/1" >/dev/null
  echo "media-provision: require at least 3 reported seeders"
fi

indexers="$(api "$base/indexer")"
if id="$(jq -er '.[] | select(.name == "1337x") | .id' <<<"$indexers" 2>/dev/null)"; then
  current="$(api "$base/indexer/$id")"
  if [ "$(jq -r '.enable' <<<"$current")" = true ]; then
    jq '.enable = false' <<<"$current" |
      api -X PUT -H 'Content-Type: application/json' --data-binary @- "$base/indexer/$id" >/dev/null
    echo "media-provision: disabled 1337x (AWS IP is blocked upstream)"
  fi
fi

if yts_id="$(jq -er '.[] | select(.name == "YTS") | .id' <<<"$indexers" 2>/dev/null)"; then
  yts="$(api "$base/indexer/$yts_id")"
  if [ "$(jq -r '.enable' <<<"$yts")" != true ]; then
    jq '.enable = true' <<<"$yts" |
      api -X PUT -H 'Content-Type: application/json' --data-binary @- "$base/indexer/$yts_id" >/dev/null
    echo "media-provision: enabled YTS"
  fi
else
  api "$base/indexer/schema" |
    jq '.[] | select(.name == "YTS") | .enable = true | .priority = 25 | .tags = [] | .appProfileId = 1' |
    api -X POST -H 'Content-Type: application/json' --data-binary @- "$base/indexer" >/dev/null
  echo "media-provision: added YTS"
fi

if eztv_id="$(jq -er '.[] | select(.name == "EZTV") | .id' <<<"$indexers" 2>/dev/null)"; then
  eztv="$(api "$base/indexer/$eztv_id")"
  if [ "$(jq -r '.enable' <<<"$eztv")" != true ] ||
     [ "$(jq -r '.fields[] | select(.name == "baseUrl") | .value' <<<"$eztv")" != https://eztv.wf ]; then
    jq '(.fields[] | select(.name == "baseUrl")).value = "https://eztv.wf" | .enable = true' <<<"$eztv" |
      api -X PUT -H 'Content-Type: application/json' --data-binary @- "$base/indexer/$eztv_id" >/dev/null
    echo "media-provision: enabled EZTV"
  fi
else
  api "$base/indexer/schema" |
    jq '.[] | select(.name == "EZTV") |
      (.fields[] | select(.name == "baseUrl")).value = "https://eztv.wf" |
      .enable = true | .priority = 25 | .tags = [] | .appProfileId = 1' |
    api -X POST -H 'Content-Type: application/json' --data-binary @- "$base/indexer" >/dev/null
  echo "media-provision: added EZTV"
fi

if tpb_id="$(jq -er '.[] | select(.name == "The Pirate Bay") | .id' <<<"$indexers" 2>/dev/null)"; then
  tpb="$(api "$base/indexer/$tpb_id")"
  if [ "$(jq -r '.enable' <<<"$tpb")" = true ]; then
    jq '.enable = false' <<<"$tpb" |
      api -X PUT -H 'Content-Type: application/json' --data-binary @- "$base/indexer/$tpb_id" >/dev/null
    echo "media-provision: disabled The Pirate Bay (API unavailable)"
  fi
fi

if knaben_id="$(jq -er '.[] | select(.name == "Knaben") | .id' <<<"$indexers" 2>/dev/null)"; then
  knaben="$(api "$base/indexer/$knaben_id")"
  if [ "$(jq -r '.enable' <<<"$knaben")" != true ]; then
    jq '.enable = true' <<<"$knaben" |
      api -X PUT -H 'Content-Type: application/json' --data-binary @- "$base/indexer/$knaben_id" >/dev/null
    echo "media-provision: enabled Knaben"
  fi
else
  api "$base/indexer/schema" |
    jq '.[] | select(.name == "Knaben") | .enable = true | .priority = 25 | .tags = [] | .appProfileId = 1' |
    api -X POST -H 'Content-Type: application/json' --data-binary @- "$base/indexer" >/dev/null
  echo "media-provision: added Knaben"
fi
inherit_minimum_seeders Nyaa.si
set_minimum_seeders Knaben 3

knaben_id="$(api "$base/indexer" | jq -er '.[] | select(.name == "Knaben") | .id')"
knaben="$(api "$base/indexer/$knaben_id")"
if [ "$(jq -r '.fields[] | select(.name == "torrentBaseSettings.preferMagnetUrl") | .value' <<<"$knaben")" != true ]; then
  jq '(.fields[] | select(.name == "torrentBaseSettings.preferMagnetUrl")).value = true' <<<"$knaben" |
    api -X PUT -H 'Content-Type: application/json' --data-binary @- "$base/indexer/$knaben_id" >/dev/null
  echo "media-provision: configured Knaben to prefer magnets"
fi

api -X POST -H 'Content-Type: application/json' \
  --data-binary '{"name":"ApplicationIndexerSync"}' "$base/command" >/dev/null

qbittorrent=http://127.0.0.1:8081/api/v2
preferences="$(curl -fsS "$qbittorrent/app/preferences")"
if [ "$(jq -r '.max_active_downloads' <<<"$preferences")" -lt 6 ] ||
   [ "$(jq -r '.max_active_torrents' <<<"$preferences")" -lt 12 ]; then
  curl -fsS -X POST "$qbittorrent/app/setPreferences" \
    --data-urlencode 'json={"max_active_downloads":6,"max_active_torrents":12}'
  echo "media-provision: increased qBittorrent active download capacity"
fi
if [ "$(jq -r '.announce_to_all_trackers' <<<"$preferences")" != true ]; then
  curl -fsS -X POST "$qbittorrent/app/setPreferences" \
    --data-urlencode 'json={"announce_to_all_trackers":true}'
  echo "media-provision: enabled all-tracker announcements"
fi
if [ "$(jq -r '.max_ratio' <<<"$preferences")" != 1 ] ||
   [ "$(jq -r '.max_seeding_time' <<<"$preferences")" != 10080 ] ||
   [ "$(jq -r '.max_seeding_time_enabled' <<<"$preferences")" != true ]; then
  curl -fsS -X POST "$qbittorrent/app/setPreferences" \
    --data-urlencode 'json={"max_ratio":1,"max_ratio_act":0,"max_seeding_time":10080,"max_seeding_time_enabled":true}'
  echo "media-provision: set seed lifecycle to ratio 1 or 7 days"
fi

configure_download_cleanup() {
  local app="$1"
  local port="$2"
  local app_key client

  app_key="$(xmlstarlet sel -t -v /Config/ApiKey "/opt/tetrapod/$app/config.xml")"
  client="$(curl -fsS -H "X-Api-Key: $app_key" "http://127.0.0.1:$port/api/v3/downloadclient" |
    jq -cer '.[] | select(.implementation == "QBittorrent")')"
  if [ "$(jq -r '.removeCompletedDownloads' <<<"$client")" != false ] ||
     [ "$(jq -r '.removeFailedDownloads' <<<"$client")" != true ]; then
    jq '.removeCompletedDownloads = false | .removeFailedDownloads = true' <<<"$client" |
      curl -fsS -X PUT -H "X-Api-Key: $app_key" -H 'Content-Type: application/json' \
        --data-binary @- "http://127.0.0.1:$port/api/v3/downloadclient/$(jq -r '.id' <<<"$client")" >/dev/null
    echo "media-provision: delegated $app completed-download cleanup to media-warden"
  fi
}

configure_download_cleanup sonarr 8989
configure_download_cleanup radarr 7878

configure_arr_storage() {
  local app="$1" port="$2" recycle="$3"
  local app_key app_base settings settings_id tag_name tags

  app_key="$(xmlstarlet sel -t -v /Config/ApiKey "/opt/tetrapod/$app/config.xml")"
  app_base="http://127.0.0.1:$port/api/v3"
  tags="$(curl -fsS -H "X-Api-Key: $app_key" "$app_base/tag")"
  for tag_name in keep temp; do
    if ! jq -e --arg name "$tag_name" 'any(.[]; .label == $name)' <<<"$tags" >/dev/null; then
      curl -fsS -X POST -H "X-Api-Key: $app_key" -H 'Content-Type: application/json' \
        --data-binary "$(jq -cn --arg label "$tag_name" '{label:$label}')" "$app_base/tag" >/dev/null
      echo "media-provision: created $app $tag_name tag"
    fi
  done

  settings="$(curl -fsS -H "X-Api-Key: $app_key" "$app_base/config/mediamanagement")"
  settings_id="$(jq -er '.id' <<<"$settings")"
  if [ "$(jq -r '.recycleBin' <<<"$settings")" != "$recycle" ] ||
     [ "$(jq -r '.recycleBinCleanupDays' <<<"$settings")" != 7 ]; then
    jq --arg path "$recycle" '.recycleBin = $path | .recycleBinCleanupDays = 7' <<<"$settings" |
      curl -fsS -X PUT -H "X-Api-Key: $app_key" -H 'Content-Type: application/json' \
        --data-binary @- "$app_base/config/mediamanagement/$settings_id" >/dev/null
    echo "media-provision: configured $app recycle bin"
  fi
}

migrate_quality_profiles() {
  local app="$1" port="$2" resource="$3"
  local app_key app_base profiles standard cinema objects id title old target

  app_key="$(xmlstarlet sel -t -v /Config/ApiKey "/opt/tetrapod/$app/config.xml")"
  app_base="http://127.0.0.1:$port/api/v3"
  profiles="$(curl -fsS -H "X-Api-Key: $app_key" "$app_base/qualityprofile")"
  standard="$(jq -er 'map(select(.name == "Standard")) | if length == 1 then .[0].id else error("Standard profile is missing or duplicated") end' <<<"$profiles")"
  cinema="$(jq -er 'map(select(.name == "Cinema")) | if length == 1 then .[0].id else error("Cinema profile is missing or duplicated") end' <<<"$profiles")"
  objects="$(curl -fsS -H "X-Api-Key: $app_key" "$app_base/$resource")"

  while IFS=$'\t' read -r id title old; do
    case "$(jq -r --argjson id "$old" '.[] | select(.id == $id) | .name' <<<"$profiles")" in
      Standard|Cinema) continue ;;
      'HD/UHD - 1080p/2160p') target="$cinema" ;;
      *) target="$standard" ;;
    esac
    jq -c --argjson id "$id" --argjson profile "$target" \
      '.[] | select(.id == $id) | .qualityProfileId = $profile' <<<"$objects" |
      curl -fsS -X PUT -H "X-Api-Key: $app_key" -H 'Content-Type: application/json' \
        --data-binary @- "$app_base/$resource/$id" >/dev/null
    echo "media-provision: migrated $app $title quality profile"
  done < <(jq -r '.[] | [.id, .title, .qualityProfileId] | @tsv' <<<"$objects")
}

configure_seerr_profiles() {
  local config=/opt/tetrapod/seerr/settings.json
  local seerr_key app port app_key profiles standard cinema settings id updated
  local seerr_ready=false

  for _ in {1..30}; do
    if [ -r "$config" ]; then
      seerr_key="$(jq -er '.main.apiKey' "$config")"
      if curl -fsS -H "X-Api-Key: $seerr_key" http://127.0.0.1:5055/api/v1/settings/main >/dev/null; then
        seerr_ready=true
        break
      fi
    fi
    sleep 2
  done
  [ "$seerr_ready" = true ] || { echo "media-provision: Seerr is not ready" >&2; return 1; }

  for app in sonarr radarr; do
    if [ "$app" = sonarr ]; then port=8989; else port=7878; fi
    app_key="$(xmlstarlet sel -t -v /Config/ApiKey "/opt/tetrapod/$app/config.xml")"
    profiles="$(curl -fsS -H "X-Api-Key: $app_key" "http://127.0.0.1:$port/api/v3/qualityprofile")"
    standard="$(jq -er '.[] | select(.name == "Standard") | .id' <<<"$profiles")"
    cinema="$(jq -er '.[] | select(.name == "Cinema") | .id' <<<"$profiles")"
    settings="$(curl -fsS -H "X-Api-Key: $seerr_key" "http://127.0.0.1:5055/api/v1/settings/$app")"

    while IFS= read -r id; do
      updated="$(jq -c --argjson id "$id" --argjson standard "$standard" --argjson cinema "$cinema" '
        .[] | select(.id == $id) |
        .activeProfileId = (if .is4k then $cinema else $standard end) |
        .activeProfileName = (if .is4k then "Cinema" else "Standard" end) |
        if has("activeAnimeProfileId") then
          .activeAnimeProfileId = (if .is4k then $cinema else $standard end) |
          .activeAnimeProfileName = (if .is4k then "Cinema" else "Standard" end)
        else . end
      ' <<<"$settings")"
      curl -fsS -X PUT -H "X-Api-Key: $seerr_key" -H 'Content-Type: application/json' \
        --data-binary "$updated" "http://127.0.0.1:5055/api/v1/settings/$app/$id" >/dev/null
      echo "media-provision: set Seerr $app profile for server $id"
    done < <(jq -r '.[].id' <<<"$settings")
  done
}

remove_legacy_profiles() {
  local app="$1" port="$2"
  local app_key app_base profile_id profile_name

  app_key="$(xmlstarlet sel -t -v /Config/ApiKey "/opt/tetrapod/$app/config.xml")"
  app_base="http://127.0.0.1:$port/api/v3"
  while IFS=$'\t' read -r profile_id profile_name; do
    curl -fsS -X DELETE -H "X-Api-Key: $app_key" "$app_base/qualityprofile/$profile_id" >/dev/null
    echo "media-provision: removed legacy $app profile $profile_name"
  done < <(curl -fsS -H "X-Api-Key: $app_key" "$app_base/qualityprofile" |
    jq -r '.[] | select(.name != "Standard" and .name != "Cinema") | [.id, .name] | @tsv')
}

configure_arr_storage sonarr 8989 /srv/media/recycle/sonarr
configure_arr_storage radarr 7878 /srv/media/recycle/radarr
migrate_quality_profiles sonarr 8989 series
migrate_quality_profiles radarr 7878 movie
configure_seerr_profiles
remove_legacy_profiles sonarr 8989
remove_legacy_profiles radarr 7878

configure_jellyfin_audio_selection() {
  local token user id configuration

  token="$(sqlite3 /opt/tetrapod/jellyfin/config/data/jellyfin.db \
    'SELECT AccessToken FROM ApiKeys ORDER BY Id LIMIT 1;')"
  user="$(curl -fsS http://127.0.0.1:8096/Users \
    -H "Authorization: MediaBrowser Token=\"$token\"" |
    jq -cer '.[] | select(.Name == "tetraslam")')"
  [ "$(jq -r '.Configuration.RememberAudioSelections' <<<"$user")" = false ] && return

  id="$(jq -r '.Id' <<<"$user")"
  configuration="$(jq '.Configuration.RememberAudioSelections = false | .Configuration' <<<"$user")"
  curl -fsS -X POST -H "Authorization: MediaBrowser Token=\"$token\"" \
    -H 'Content-Type: application/json' --data-binary "$configuration" \
    "http://127.0.0.1:8096/Users/Configuration?userId=$id" >/dev/null
  echo "media-provision: disabled remembered audio tracks for tetraslam"
}

configure_jellyfin_audio_selection

sonarr_key="$(xmlstarlet sel -t -v /Config/ApiKey /opt/tetrapod/sonarr/config.xml)"
sonarr=http://127.0.0.1:8989/api/v3
media_management="$(curl -fsS -H "X-Api-Key: $sonarr_key" "$sonarr/config/mediamanagement")"
if [ "$(jq -r '.importExtraFiles' <<<"$media_management")" != true ]; then
  jq '.importExtraFiles = true | .extraFileExtensions = "srt"' <<<"$media_management" |
    curl -fsS -X PUT -H "X-Api-Key: $sonarr_key" -H 'Content-Type: application/json' \
      --data-binary @- "$sonarr/config/mediamanagement/$(jq -er '.id' <<<"$media_management")" >/dev/null
  echo "media-provision: enabled Sonarr subtitle imports"
fi
