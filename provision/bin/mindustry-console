#!/usr/bin/env python3
"""Send one command to the TTY-only Mindustry console without printing it."""

import os
import pty
import subprocess
import sys
import time
import tty


command = sys.stdin.buffer.readline().rstrip(b"\n")
if not command:
    raise SystemExit("mindustry-console: expected one command on stdin")

master, slave = pty.openpty()
tty.setraw(slave)
process = subprocess.Popen(
    ["docker", "attach", "--detach-keys=ctrl-x", "provision-mindustry-1"],
    stdin=slave,
    stdout=slave,
    stderr=slave,
)
os.close(slave)

try:
    time.sleep(1)
    os.write(master, command + b"\n")
    time.sleep(2)
    os.write(master, b"\x18")
    process.wait(timeout=5)
finally:
    os.close(master)
    if process.poll() is None:
        process.terminate()
        process.wait(timeout=5)

# Docker exits 1 when its detach key closes an attach session.
if process.returncode not in (0, 1):
    raise SystemExit(process.returncode)
