#!/usr/bin/env -S /home/tetraslam/.local/bin/uv run --script --quiet
# /// script
# requires-python = ">=3.12"
# dependencies = ["aiosmtpd==1.4.6", "msal==1.38.0"]
# ///
"""Authenticated SMTP submission bridge to Microsoft Graph."""

import argparse
import asyncio
import base64
import hmac
import os
import signal
import ssl
import subprocess
import sys
import tempfile
import threading
import urllib.error
import urllib.request
from email.parser import BytesParser
from email.utils import getaddresses
from pathlib import Path

import msal
from aiosmtpd.controller import Controller
from aiosmtpd.smtp import AuthResult, LoginPassword

ADDRESS = "shresht@mit.edu"
CLIENT_ID = "9e5f94bc-e8a4-4e73-b8be-63364c29d753"
AUTHORITY = "https://login.microsoftonline.com/common"
SCOPES = ["https://graph.microsoft.com/Mail.Send"]
STATE_DIR = Path("/var/lib/mit-graph-smtp")
CACHE_PATH = STATE_DIR / "token-cache.json"
PASSWORD_REF = "op://Agents/MIT Mail Proxy/password"
HOST = "100.79.126.72"
PORT = 1465
CERT = "/var/lib/email-oauth2-proxy/tls/cert.pem"
KEY = "/var/lib/email-oauth2-proxy/tls/key.pem"


def load_cache() -> msal.SerializableTokenCache:
    cache = msal.SerializableTokenCache()
    if CACHE_PATH.exists():
        cache.deserialize(CACHE_PATH.read_text())
    return cache


def save_cache(cache: msal.SerializableTokenCache) -> None:
    if not cache.has_state_changed:
        return
    STATE_DIR.mkdir(mode=0o700, parents=True, exist_ok=True)
    fd, name = tempfile.mkstemp(dir=STATE_DIR)
    try:
        os.fchmod(fd, 0o600)
        with os.fdopen(fd, "w") as output:
            output.write(cache.serialize())
        os.replace(name, CACHE_PATH)
    finally:
        if os.path.exists(name):
            os.unlink(name)


def application(cache: msal.SerializableTokenCache) -> msal.PublicClientApplication:
    return msal.PublicClientApplication(CLIENT_ID, authority=AUTHORITY, token_cache=cache)


def authorize() -> None:
    cache = load_cache()
    app = application(cache)
    flow = app.initiate_device_flow(scopes=SCOPES)
    if "user_code" not in flow:
        raise RuntimeError(flow.get("error_description", "device authorization failed"))
    print(flow["message"], flush=True)
    result = app.acquire_token_by_device_flow(flow)
    save_cache(cache)
    if "access_token" not in result:
        raise RuntimeError(result.get("error_description", "authorization failed"))
    print(f"authorized {result.get('id_token_claims', {}).get('preferred_username', ADDRESS)}")


def local_password() -> bytes:
    return subprocess.check_output(["/usr/local/bin/opa", "read", PASSWORD_REF]).strip()


class GraphRelay:
    def __init__(self) -> None:
        self.password = local_password()
        self.cache = load_cache()
        self.app = application(self.cache)
        self.token_lock = threading.Lock()

    def authenticate(self, _server, _session, _envelope, _mechanism, auth_data):
        if not isinstance(auth_data, LoginPassword):
            return AuthResult(success=False, handled=False)
        valid = hmac.compare_digest(auth_data.login, ADDRESS.encode())
        valid &= hmac.compare_digest(auth_data.password, self.password)
        return AuthResult(success=valid, handled=valid, auth_data=auth_data if valid else None)

    def access_token(self) -> str:
        with self.token_lock:
            accounts = self.app.get_accounts(username=ADDRESS)
            result = self.app.acquire_token_silent(SCOPES, account=accounts[0]) if accounts else None
            save_cache(self.cache)
        if not result or "access_token" not in result:
            raise RuntimeError("Graph authorization missing or expired; run mit-graph-smtp authorize")
        return result["access_token"]

    @staticmethod
    def add_envelope_recipients(content: bytes, recipients: list[str]) -> bytes:
        message = BytesParser().parsebytes(content, headersonly=True)
        header_values = sum((message.get_all(name, []) for name in ("to", "cc", "bcc")), [])
        header_recipients = {address.lower() for _, address in getaddresses(header_values)}
        missing = [address for address in recipients if address.lower() not in header_recipients]
        if not missing:
            return content
        if any("\r" in address or "\n" in address for address in missing):
            raise RuntimeError("invalid envelope recipient")
        separator = b"\r\n\r\n"
        position = content.find(separator)
        if position < 0:
            raise RuntimeError("message has no MIME header separator")
        return content[:position] + f"\r\nBcc: {', '.join(missing)}".encode() + content[position:]

    def send(self, content: bytes, recipients: list[str]) -> None:
        content = self.add_envelope_recipients(content, recipients)
        request = urllib.request.Request(
            "https://graph.microsoft.com/v1.0/me/sendMail",
            data=base64.b64encode(content),
            headers={
                "Authorization": f"Bearer {self.access_token()}",
                "Content-Type": "text/plain",
            },
            method="POST",
        )
        try:
            with urllib.request.urlopen(request, timeout=30) as response:
                if response.status != 202:
                    raise RuntimeError(f"Graph returned HTTP {response.status}")
        except urllib.error.HTTPError as error:
            detail = error.read(2048).decode(errors="replace")
            raise RuntimeError(f"Graph returned HTTP {error.code}: {detail}") from error

    async def handle_DATA(self, _server, _session, envelope):
        if envelope.mail_from.lower() != ADDRESS:
            return "553 sender must be shresht@mit.edu"
        try:
            await asyncio.to_thread(self.send, envelope.original_content, envelope.rcpt_tos)
        except Exception as error:
            print(f"delivery failed: {error}", file=sys.stderr, flush=True)
            return "451 Graph delivery failed"
        print(f"accepted message for {len(envelope.rcpt_tos)} recipient(s)", flush=True)
        return "250 accepted by Microsoft Graph"


def serve() -> None:
    relay = GraphRelay()
    context = ssl.create_default_context(ssl.Purpose.CLIENT_AUTH)
    context.minimum_version = ssl.TLSVersion.TLSv1_2
    context.load_cert_chain(CERT, KEY)
    controller = Controller(
        relay,
        hostname=HOST,
        port=PORT,
        ssl_context=context,
        authenticator=relay.authenticate,
        auth_required=True,
        auth_require_tls=False,  # aiosmtpd cannot detect TLS supplied by ssl_context
        data_size_limit=3_000_000,
        decode_data=False,
        enable_SMTPUTF8=True,
    )
    stopped = threading.Event()
    signal.signal(signal.SIGTERM, lambda *_: stopped.set())
    signal.signal(signal.SIGINT, lambda *_: stopped.set())
    controller.start()
    print(f"listening on {HOST}:{PORT}", flush=True)
    stopped.wait()
    controller.stop()


def main() -> None:
    parser = argparse.ArgumentParser()
    parser.add_argument("command", choices=("authorize", "serve"))
    args = parser.parse_args()
    authorize() if args.command == "authorize" else serve()


if __name__ == "__main__":
    main()
