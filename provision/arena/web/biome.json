{
  "$schema": "https://biomejs.dev/schemas/2.6.9/schema.json",
  "formatter": { "indentStyle": "space", "indentWidth": 2, "lineWidth": 110 },
  "linter": {
    "rules": {
      "style": { "noNonNullAssertion": "off", "noDescendingSpecificity": "off" },
      "complexity": { "noImportantStyles": "off", "useMathMinMax": "off" },
      "suspicious": { "noAssignInExpressions": "off" }
    }
  }
}
